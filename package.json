{
  "name": "rnforge-dev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "gen:api-reference": "bun run scripts/gen-api-reference.mjs",
    "check:api-reference": "bun run gen:api-reference && git diff --exit-code content/docs/packages/react-native-in-app-updates/reference.mdx",
